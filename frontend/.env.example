# Copy to .env.local and adjust. All are optional — the defaults below are
# what the app uses when the file is absent.

# API base URL. The default is relative, so requests go through the Vite dev
# proxy (vite.config.ts) to http://127.0.0.1:8000 with no CORS setup.
# Set an absolute URL to talk to a different backend.
VITE_API_BASE=/api/v1

# Must match a key in the backend's API_KEYS setting (see ../.env.example).
VITE_API_KEY=dev-public-key

# The customer this session acts as. The backend scopes every conversation to
# this id; a real sign-in replaces it later.
VITE_CUSTOMER_ID=1
