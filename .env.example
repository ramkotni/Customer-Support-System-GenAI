# =============================================================================
# Customer Support System — environment configuration (copy to .env)
# =============================================================================

# ---- App ----
APP_NAME="Customer Support API"
ENV=development                 # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                   # structured JSON logs

# ---- Database ----
# Default resolves to the repo's SQLite DB (_DB/ecommerce.db). Leave blank to auto-detect.
# Postgres example:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/support
DATABASE_URL=

# ---- Security / Auth ----
# Comma-separated "name:key" pairs. The agent uses AGENT_SERVICE_KEY to call its own tools.
API_KEYS=public:dev-public-key,agent:dev-agent-key
AGENT_SERVICE_KEY=dev-agent-key

# ---- Rate limiting (in-memory token bucket; swap for Redis in prod) ----
RATE_LIMIT_PER_MINUTE=120

# ---- External dependency resilience ----
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
CIRCUIT_BREAKER_FAIL_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# ---- Agent / LLM ----
# If ANTHROPIC_API_KEY is unset, the agent runs in deterministic offline mode
# (rule-based planner) so the whole system remains runnable and testable.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=1024
AGENT_MAX_STEPS=8
AGENT_REFUND_APPROVAL_LIMIT_CENTS=10000   # $100.00 — agent may auto-approve at/below this

# ---- CORS (browser clients) ----
# Comma-separated origins allowed to call the API from a browser. The Vite dev
# server proxies /api, so this only matters when the frontend is served from a
# different origin than the API. Empty disables CORS entirely.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
